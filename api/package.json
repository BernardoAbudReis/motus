{
  "name": "habitos-academia-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrar": "tsx --env-file-if-exists=.env src/migrar.ts",
    "test": "tsx --env-file-if-exists=.env --import ./test/ambiente.ts --test --test-concurrency=1 test/*.test.ts",
    "backup": "tsx --env-file-if-exists=.env -e \"import('./src/backup.ts').then(async (m) => { const r = await m.gerarBackup(process.env.BACKUP_DIR ?? 'backups'); console.log(r); (await import('./src/banco.ts')).pool.end() })\"",
    "restaurar": "tsx --env-file-if-exists=.env src/restaurar.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "web-push": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
